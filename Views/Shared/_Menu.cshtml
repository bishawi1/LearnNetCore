@model List<MainMenu>
@foreach (var menu in Model)
        {
            var strID = "main_" + menu.Id.ToString();
    <li id=@strID Class="nav-item dropdown">
        <a asp-action="ListRoles" asp-controller="Administration" class="nav-link dropdown-toggle"
           id="navbarDropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            @menu.MainMenuText
        </a>
        @if (menu.SubMenus.Count > 0)
        {
        <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
            @foreach (var subMenu in menu.SubMenus)
                    {
                        var strSubID = "link" + subMenu.Id.ToString();
            <a asp-action="ListTasks" asp-controller="Tasks"
                      id=@strSubID class="dropdown-item">
                @subMenu.SubMenuName
            </a>
            }
        </div>
        }
    </li>
}

